
# AutoResolve 2.0 — example configuration
# Copy this file to .env and fill in your own credentials.
# Never commit .env or real API keys.

# ==========================================
# APPLICATION
# ==========================================

AUTORESOLVE_REAL_ENGINE=false
MAX_ITERATIONS=3

# SQLite database; leave empty to use the default autoresolve.db
DATABASE_URL=

# ==========================================
# AI BACKEND
# ==========================================

# Options: remote or ollama
AUTORESOLVE_AI_BACKEND=remote

# Remote providers supported by the current implementation:
# gemini, groq
AI_ENABLED_PROVIDERS=gemini,groq
AI_PRIMARY_PROVIDER=gemini

AI_FALLBACK_ENABLED=false
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=0

# Paid providers are intentionally disabled.
ALLOW_PAID_PROVIDERS=false

# ==========================================
# GEMINI
# ==========================================

GEMINI_API_KEY=
GEMINI_MODEL=

# ==========================================
# GROQ
# ==========================================

GROQ_API_KEY=
GROQ_MODEL=

# ==========================================
# USAGE LIMITS
# ==========================================

AI_GEMINI_DAILY_LIMIT=20
AI_GROQ_DAILY_LIMIT=30
AI_USAGE_DB_PATH=.autoresolve_data/ai_usage.sqlite3

# ==========================================
# LOCAL OLLAMA (optional)
# ==========================================

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ==========================================
# GITHUB
# ==========================================

# Required when running the RealFixEngine.
GITHUB_TOKEN=

# Publishing and merging require separate opt-in.
AUTORESOLVE_ENABLE_PUBLISH=false
AUTORESOLVE_ENABLE_MERGE=false

# ==========================================
# DOCKER
# ==========================================

AUTORESOLVE_WORKER_IMAGE=autoresolve-test-worker:python312

# Optional. Set to an absolute path in .env if necessary.
# For the Snap Docker installation, use a workspace inside
# your AutoResolve project directory.
# AUTORESOLVE_WORKSPACE_DIR=

# ==========================================
# GOOGLE SHEETS (optional)
# ==========================================

GOOGLE_SHEET_ID=
GOOGLE_SHEET_URL=
GOOGLE_CREDENTIALS_FILE=credentials/credentials.json
SHEET_POLL_SECONDS=60
